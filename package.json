{
  "name": "webtui-chat-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:check": "node scripts/generate-store-assets.mjs --check",
    "assets:store": "node scripts/generate-store-assets.mjs",
    "check:production": "node scripts/check-production.mjs",
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.17",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@playwright/test": "1.61.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.6.0",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  }
}
