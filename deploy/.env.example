PORTAL_DOMAIN=download.vpsttt.com
PORTAL_ORIGIN=https://download.vpsttt.com
PORTAL_BASE_PATH=
PORTAL_VERSION=latest
LETSENCRYPT_EMAIL=admin@vpsttt.com
DESKTOP_DOWNLOAD_URL=https://download.vpsttt.com/download/
MOBILE_DOWNLOAD_URL=CHANGE_ME_PLAY_STORE_OR_TEST_TRACK_URL
DOCUMENTATION_URL=https://download.vpsttt.com/#self-host

# Public legal identity. The build rejects blanks and CHANGE_ME/TODO placeholders.
LEGAL_ENTITY_NAME=CHANGE_ME_LEGAL_ENTITY_NAME
LEGAL_ENTITY_ADDRESS=CHANGE_ME_LEGAL_ENTITY_POSTAL_ADDRESS
LEGAL_ENTITY_COUNTRY=CHANGE_ME_LEGAL_ENTITY_COUNTRY
SUPPORT_EMAIL=support@vpsttt.com
PRIVACY_CONTACT_EMAIL=privacy@vpsttt.com
SAFETY_CONTACT_EMAIL=safety@vpsttt.com
POLICY_VERSION=2026-08-07
POLICY_EFFECTIVE_DATE=2026-08-07

# Must match the real backend/operator policy and deletion implementation.
ACCOUNT_DELETION_COMPLETION_DAYS=30
MODERATION_EVIDENCE_RETENTION_DAYS=365
SUPPORT_RESPONSE_HOURS=72
UGC_REPORT_RESPONSE_HOURS=72

# APP_LINK_ORIGIN must always be the exact HTTPS host in the Android manifest.
APP_LINK_ORIGIN=https://chat.vpsttt.com
# Use the SHA-256 shown under Play Console > App integrity > App signing key certificate.
# Do not use the local upload-key fingerprint. Separate multiple Play certs with commas.
PLAY_APP_SIGNING_SHA256_FINGERPRINTS=CHANGE_ME_PLAY_APP_SIGNING_SHA256

# Safe Play-only default: AASA returns 404 and both Apple values must stay blank.
# Change to true only after the signed iOS app has the matching Associated Domain.
ENABLE_IOS_ASSOCIATION=false
# Required only when ENABLE_IOS_ASSOCIATION=true. Use real Apple Developer values;
# never enter a guessed/placeholder Team ID or bundle ID.
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=
