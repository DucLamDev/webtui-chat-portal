{
	email {$LETSENCRYPT_EMAIL}
	admin off
}

{$PORTAL_DOMAIN} {
	encode zstd gzip

	redir /download /download/ 308
	redir /account-deletion /download/account-deletion.html 308
	redir /privacy /download/privacy.html 308

	handle_path /download/* {
		root * /srv/download
		file_server
	}

	handle_path /downloads/files/* {
		root * /srv/download
		file_server
	}

	handle {
		reverse_proxy portal:3002
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
