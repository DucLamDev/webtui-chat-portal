{
	email {$LETSENCRYPT_EMAIL}
	admin off
}

{$PORTAL_DOMAIN} {
	encode zstd gzip

	redir /download /download/ 308
	redir /download/account-deletion.html {$PORTAL_BASE_PATH}/account-deletion 308
	redir /download/privacy.html {$PORTAL_BASE_PATH}/privacy 308
	respond /download/dev-download.html 404
	respond /download/android/dev/* 404
	respond /downloads/files/android/dev/* 404

	# Digital Asset Links must be returned directly (no redirect) from the exact
	# Android app-link host. AASA is 200 only when ENABLE_IOS_ASSOCIATION=true;
	# the portal returns 404 in Play-only mode. When APP_LINK_ORIGIN is a different
	# host, that app host/backend must expose the same status/payload without redirect.
	handle /.well-known/assetlinks.json {
		rewrite * {$PORTAL_BASE_PATH}{uri}
		reverse_proxy portal:3002
	}

	handle /.well-known/apple-app-site-association {
		rewrite * {$PORTAL_BASE_PATH}{uri}
		reverse_proxy portal:3002
	}

	handle_path /download/* {
		root * /srv/download
		file_server
	}

	handle_path /downloads/files/* {
		root * /srv/download
		file_server
	}

	handle {
		reverse_proxy portal:3002
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}
}
